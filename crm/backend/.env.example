# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (DigitalOcean Managed Postgres or local)
DATABASE_URL=postgres://user:password@localhost:5432/tax_crm

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=
