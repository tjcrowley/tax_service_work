TWILIO_TWIML_APP_SID=

# DigitalOcean Spaces (S3-compatible doc storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=

# SendGrid (transactional email + invites)
SENDGRID_API_KEY=
